{
  "name": "yo-go-admin-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Responsive admin dashboard for the Yo Go! app: active users per platform, revenue and KPIs.",
  "type": "module",
  "source": [
    "index.html",
    "404.html"
  ],
  "scripts": {
    "start": "parcel --port 1234",
    "dev": "parcel --port 1234",
    "build": "parcel build --dist-dir build --public-url ./",
    "preview": "npx --yes serve build -l 4173",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "clean": "rm -rf build dist .parcel-cache"
  },
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "parcel": "^2.16.4",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
